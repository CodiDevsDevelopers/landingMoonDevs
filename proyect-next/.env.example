# Public DSN shared by the Sentry SDKs. Defaults are baked into the
# instrumentation files, so set this only to override them.
NEXT_PUBLIC_SENTRY_DSN=

# Build-time token used to upload source maps for readable production stack
# traces. Add it to Vercel/CI env vars; never commit a real value.
SENTRY_AUTH_TOKEN=

# Optional override for the Cal.com event used by the booking calendar.
# Accepts "usuario/evento" or a full https://cal.com/usuario/evento URL.
# Defaults to codidevs-ojncyo/15min when empty.
NEXT_PUBLIC_CALCOM_DIAGNOSTICO_LINK=
